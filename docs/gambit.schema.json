{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "side": {
      "type": "string",
      "enum": [
        "white",
        "black"
      ]
    },
    "subtitle": {
      "type": "string",
      "minLength": 1
    },
    "character": {
      "type": "string",
      "minLength": 1
    },
    "ideas": {
      "type": "object",
      "properties": {
        "idea": {
          "type": "string",
          "minLength": 1
        },
        "structure": {
          "type": "string",
          "minLength": 1
        },
        "pieces": {
          "type": "string",
          "minLength": 1
        },
        "motifs": {
          "type": "string",
          "minLength": 1
        },
        "declined": {
          "type": "string",
          "minLength": 1
        },
        "caution": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "idea",
        "structure",
        "pieces",
        "motifs",
        "declined",
        "caution"
      ],
      "additionalProperties": false
    },
    "setup": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "lines": {
      "minItems": 3,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "moves": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "name",
          "moves"
        ],
        "additionalProperties": false
      }
    },
    "source": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "retrievedAt": {
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "name",
        "url",
        "retrievedAt",
        "note"
      ],
      "additionalProperties": false
    },
    "frequencies": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "total": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "counts": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[a-h][1-8][a-h][1-8][qrbn]?$"
            },
            "additionalProperties": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          }
        },
        "required": [
          "total",
          "counts"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "name",
    "side",
    "subtitle",
    "character",
    "ideas",
    "setup",
    "lines",
    "source",
    "frequencies"
  ],
  "additionalProperties": false
}
